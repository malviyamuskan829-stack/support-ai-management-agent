# ====================================================================
# Git Ignore: Support AI Ticket Management Agent
# Covers node_modules, .env, build/dist, logs, and IDE/system files
# ====================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production Build Outputs
dist/
build/
out/
.next/
*.tsbuildinfo

# Environment & Secret files (CRITICAL)
.env
.env.local
.env.*.local
*.pem
*.key

# Runtime & Application Logs
logs/
*.log

# Editor & IDE configurations
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Test Coverage & Temp
coverage/
.nyc_output/
*.sqlite
*.db
